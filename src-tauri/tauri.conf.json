{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraceLab",
  "version": "0.1.0",
  "identifier": "research.tracelab.desktop",
  "build": { "beforeDevCommand": "pnpm dev", "beforeBuildCommand": "pnpm build", "devUrl": "http://127.0.0.1:1420", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "TraceLab", "width": 1480, "height": 960, "minWidth": 1060, "minHeight": 700, "backgroundColor": "#111413" }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "category": "DeveloperTool", "shortDescription": "Trajectory analysis and intervention workbench" }
}
